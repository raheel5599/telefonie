FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv sox ca-certificates && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/piper && /opt/piper/bin/pip install --no-cache-dir piper-tts==1.8.0
COPY deployment/install-voice.py /opt/install-voice.py
RUN python3 /opt/install-voice.py
ENV PIPER_PYTHON=/opt/piper/bin/python OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1
WORKDIR /app
CMD ["node", "server.mjs"]
